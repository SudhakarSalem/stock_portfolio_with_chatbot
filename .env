# Required: get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (defaults shown)
# gemini-3.5-flash is not a real released model name — gemini-2.5-flash is
# the current stable Flash model. Swap in gemini-flash-latest or
# gemini-3-flash-preview here any time without touching code.
GEMINI_MODEL=gemini-3.5-flash
MAX_PORTFOLIO_STOCKS=10
SUGGESTION_CACHE_TTL=300
PRICE_CACHE_TTL=60
